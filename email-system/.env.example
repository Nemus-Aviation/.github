# Nemus Aviation — Email System configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- SMTP transport ---------------------------------------------------------
# Any SMTP provider works (SendGrid, Amazon SES, Postmark, Gmail, Mailgun, ...).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# `true` for port 465 (implicit TLS), `false` for 587/25 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=apikey-or-username
SMTP_PASS=your-smtp-password-or-api-key

# --- Sender identity --------------------------------------------------------
MAIL_FROM_NAME=Nemus Aviation
MAIL_FROM_ADDRESS=notifications@nemusaviation.com
# Where bounces / replies should go (optional).
MAIL_REPLY_TO=support@nemusaviation.com

# --- Branding (used in templates) ------------------------------------------
COMPANY_NAME=Nemus Aviation
COMPANY_URL=https://nemusaviation.com
COMPANY_SUPPORT_EMAIL=support@nemusaviation.com
BRAND_COLOR=#0b3d5b

# --- Behaviour --------------------------------------------------------------
# When true, no email is sent — messages are logged to the console instead.
# Useful for local development and CI.
DRY_RUN=false
