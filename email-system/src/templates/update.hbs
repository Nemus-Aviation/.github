{{#> layout}}
  <p style="margin:0 0 8px; font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; color:{{brand.brandColor}};">Update</p>
  <h1 style="margin:0 0 16px; font-size:22px; color:#1f2933;">{{title}}</h1>

  <div style="font-size:15px; line-height:1.7; color:#1f2933;">
    {{#if message}}
    <p style="margin:0 0 16px;">{{message}}</p>
    {{/if}}

    {{#if changes.length}}
    <ul style="margin:0 0 16px; padding-left:20px;">
      {{#each changes}}
      <li style="margin:0 0 8px;">{{this}}</li>
      {{/each}}
    </ul>
    {{/if}}
  </div>

  {{#if detailsUrl}}
  <p style="margin:0; font-size:14px;">
    <a href="{{detailsUrl}}" style="color:{{brand.brandColor}}; font-weight:600;">View full details &rarr;</a>
  </p>
  {{/if}}
{{/layout}}
