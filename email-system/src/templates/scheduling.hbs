{{#> layout}}
  <p style="margin:0 0 8px; font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; color:{{brand.brandColor}};">{{#if statusLabel}}{{statusLabel}}{{else}}Scheduling{{/if}}</p>
  <h1 style="margin:0 0 16px; font-size:22px; color:#1f2933;">{{title}}</h1>

  <p style="margin:0 0 20px; font-size:15px; line-height:1.6;">
    Hi {{passengerName}}, here are the details for your upcoming flight.
  </p>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e4e7eb; border-radius:8px; margin:0 0 20px; font-size:14px;">
    <tr>
      <td style="padding:12px 16px; border-bottom:1px solid #eef1f4; color:#7b8794; width:40%;">Flight</td>
      <td style="padding:12px 16px; border-bottom:1px solid #eef1f4; font-weight:600;">{{flightNumber}}</td>
    </tr>
    <tr>
      <td style="padding:12px 16px; border-bottom:1px solid #eef1f4; color:#7b8794;">Departure</td>
      <td style="padding:12px 16px; border-bottom:1px solid #eef1f4;">{{origin}} &middot; {{datetime departureTime tz=departureTimeZone}}</td>
    </tr>
    <tr>
      <td style="padding:12px 16px; border-bottom:1px solid #eef1f4; color:#7b8794;">Arrival</td>
      <td style="padding:12px 16px; border-bottom:1px solid #eef1f4;">{{destination}} &middot; {{datetime arrivalTime tz=arrivalTimeZone}}</td>
    </tr>
    {{#if aircraft}}
    <tr>
      <td style="padding:12px 16px; border-bottom:1px solid #eef1f4; color:#7b8794;">Aircraft</td>
      <td style="padding:12px 16px; border-bottom:1px solid #eef1f4;">{{aircraft}}</td>
    </tr>
    {{/if}}
    {{#if gate}}
    <tr>
      <td style="padding:12px 16px; color:#7b8794;">Gate / FBO</td>
      <td style="padding:12px 16px; font-weight:600;">{{gate}}</td>
    </tr>
    {{/if}}
  </table>

  {{#if manageUrl}}
  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 20px;">
    <tr>
      <td style="border-radius:6px; background-color:{{brand.brandColor}};">
        <a href="{{manageUrl}}" style="display:inline-block; padding:12px 28px; color:#ffffff; text-decoration:none; font-weight:600; font-size:15px;">Manage booking</a>
      </td>
    </tr>
  </table>
  {{/if}}

  {{#if note}}
  <p style="margin:0; font-size:13px; color:#7b8794;">{{note}}</p>
  {{/if}}
{{/layout}}
