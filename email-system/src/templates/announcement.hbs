{{#> layout}}
  <h1 style="margin:0 0 16px; font-size:22px; color:#1f2933;">{{title}}</h1>
  {{#if subtitle}}
  <p style="margin:0 0 20px; font-size:15px; color:#7b8794;">{{subtitle}}</p>
  {{/if}}

  <div style="font-size:15px; line-height:1.7; color:#1f2933;">
    {{#each paragraphs}}
    <p style="margin:0 0 16px;">{{this}}</p>
    {{/each}}
  </div>

  {{#if ctaUrl}}
  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:8px 0 20px;">
    <tr>
      <td style="border-radius:6px; background-color:{{brand.brandColor}};">
        <a href="{{ctaUrl}}" style="display:inline-block; padding:12px 28px; color:#ffffff; text-decoration:none; font-weight:600; font-size:15px;">{{#if ctaLabel}}{{ctaLabel}}{{else}}Learn more{{/if}}</a>
      </td>
    </tr>
  </table>
  {{/if}}
{{/layout}}
